{
  "title": "DASHBOARD-WEB Monitoring",
  "uid": "dashboard-web-monitoring",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [

    {
      "id": 1,
      "title": "Request Rate by Status Code (req/s)",
      "description": "Số request mỗi giây, phân theo HTTP status. 429 = rate limit bị kích hoạt, 5xx = lỗi backend.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum by (status) (rate({job=\"nginx-gateway\"}[1m]))",
          "legendFormat": "status {{status}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "status 200" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "status 429" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "status 500" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 2,
      "title": "Latency Percentiles — p90 / p95 / p99 (seconds)",
      "description": "Thời gian xử lý request từ nginx đến khi trả về client. p99 cao > 2s thường chỉ backend đang chậm.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "quantile_over_time(0.90, {job=\"nginx-gateway\"} | json | unwrap request_time [5m]) by ()",
          "legendFormat": "p90",
          "queryType": "range",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.95, {job=\"nginx-gateway\"} | json | unwrap request_time [5m]) by ()",
          "legendFormat": "p95",
          "queryType": "range",
          "refId": "B"
        },
        {
          "expr": "quantile_over_time(0.99, {job=\"nginx-gateway\"} | json | unwrap request_time [5m]) by ()",
          "legendFormat": "p99",
          "queryType": "range",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p90" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 6,
      "title": "429 Rate Limit — theo từng API (mỗi 15s)",
      "description": "/api/superset: rate limit 50r/s — /api/query (chatbot): rate limit 6r/m (1 req/10s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"nginx-gateway\", status=\"429\"} | json | uri=~\"/api/superset.*\" [15s]))",
          "legendFormat": "/api/superset",
          "queryType": "range",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=\"nginx-gateway\", status=\"429\"} | json | uri=\"/api/query\" [15s]))",
          "legendFormat": "/api/query (chatbot)",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "bars" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "/api/superset" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "/api/query (chatbot)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },

    {
      "id": 5,
      "title": "Total Requests mỗi 30s",
      "description": "Tổng số request gửi tới nginx gateway trong từng khoảng 30 giây",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({job=\"nginx-gateway\"}[30s]))",
          "legendFormat": "{{status}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "bars" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "200" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "429" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "500" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "404" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },

    {
      "id": 3,
      "title": "Container CPU Usage per Service",
      "description": "CPU của từng container. Nếu backend-1/2/3 lệch nhau nhiều → load balancing có vấn đề.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/docker.*\"}[1m]))",
          "legendFormat": "{{ id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 5 },
          "unit": "percentunit"
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } }
    },

    {
      "id": 4,
      "title": "Container Memory Usage per Service",
      "description": "RAM của từng container theo thời gian. Tăng liên tục không giảm = memory leak.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{id=~\"/docker.*\"}",
          "legendFormat": "{{ id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 5 },
          "unit": "bytes"
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } }
    }

  ],

  "templating": { "list": [] },

  "schemaVersion": 38,
  "version": 1
}
